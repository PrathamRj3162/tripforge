# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Never paste real keys into this example file.

# ---------- Browser (public by design: baked into the JS bundle) ----------
# Firebase console > Project settings > Your apps > Web app > firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- Server only (NEVER prefix these with VITE_) ----------
# aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated, tried in order if the main model is busy / rate limited / missing
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# low | medium | high | off   (gemini-3.8-flash cannot disable thinking; "off" just omits the setting)
GEMINI_THINKING_LEVEL=low

# Google Cloud console > APIs & Services > enable "Places API (New)" > Credentials > API key
GOOGLE_PLACES_API_KEY=
# (cities) = only cities. Empty = any place. Or a list such as locality,country
PLACES_AUTOCOMPLETE_TYPES=(cities)

# Firebase console > Project settings > Service accounts > Generate new private key,
# then run:  npm run encode:sa -- path/to/key.json   and paste the single line it prints.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Protect your free Gemini quota (counted per UTC day)
DAILY_TRIP_LIMIT=8
GLOBAL_DAILY_TRIP_LIMIT=40
# How long identical requests are served from the shared cache
CACHE_TTL_HOURS=168
